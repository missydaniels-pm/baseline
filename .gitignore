.venv
instance/
# Any SQLite file anywhere, not just instance/ — a stray root-level
# migraine_tracker.db is easy to create by accident and would be real health
# data. Never committable.
*.db
*.sqlite
*.sqlite3
.env
.DS_Store
# Personal/local Claude tooling configs, anywhere in the tree — root OR a stray
# nested .claude/ (e.g. one accidentally created under a subfolder). Scoped to
# the specific local files so .claude/agents/*.md (the tracked review agents)
# stays tracked.
**/.claude/settings.local.json
**/.claude/launch.json
.claude/worktrees/
# scripts/error_sweep.py's "last swept at" marker — local state, per machine.
.claude/error_sweep_last
__pycache__/
~$*

# Exit-gate review reports list current weaknesses and the repo is public —
# kept local only (owner decision 10/4/26). Commit a redacted copy once fixed.
Baseline Files/EXIT-GATE-REVIEW-*.md
