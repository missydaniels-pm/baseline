{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["/backups/**"]
  },
  "deploy": {
    "cronSchedule": "0 10 * * *",
    "restartPolicyType": "NEVER"
  },
  "environments": {
    "staging": {
      "deploy": {
        "cronSchedule": null
      }
    }
  }
}
