{
  "expo": {
    "name": "Baseline",
    "slug": "baseline-health-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f0f13",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.mybaselineapp.health",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "CFBundleDisplayName": "Baseline Sync"
      }
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Baseline reads your heart rate variability and blood glucose readings so you can compare them with your episodes.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization"
    ]
  }
}
