# Top-level dependencies — the ONLY file to edit by hand. requirements.txt is
# generated from this with pip-tools and pins every package (incl. transitive)
# to the exact version tested, so a build can't silently pick up a new release.
# Regenerate after editing (on Python 3.14, matching the Dockerfile):
#   python3.14 -m piptools compile --strip-extras -o requirements.txt requirements.in
# Upgrade everything deliberately:  ... compile --upgrade ...  then run all suites.

